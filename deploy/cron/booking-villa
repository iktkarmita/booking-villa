# /etc/cron.d/booking-villa : scheduler Laravel (kedaluwarsa booking tiap menit, pengingat, langganan)
* * * * * www-data cd /var/www/booking-villa && php artisan schedule:run >> /dev/null 2>&1
# Backup harian pukul 02:30
30 2 * * * root /var/www/booking-villa/deploy/backup.sh >> /var/log/booking-villa-backup.log 2>&1
