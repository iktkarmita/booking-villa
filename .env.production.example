# Salin ke .env di server (chmod 640, jangan di-commit). Ganti semua nilai bertanda GANTI.
APP_NAME="Booking Villa"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://domainkamu.com # GANTI
APP_TIMEZONE=Asia/Makassar     # WIB: Asia/Jakarta, WITA: Asia/Makassar, WIT: Asia/Jayapura. Menentukan "hari ini" & jam scheduler
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Domain induk: situs tenant = {subdomain}.domainkamu.com
APP_BASE_DOMAIN=domainkamu.com # GANTI
# Host "pusat" selain domain induk (panel /platform dan /admin), dipisah koma
BOOKING_CENTRAL_HOSTS=domainkamu.com,app.domainkamu.com # GANTI

# Super admin pertama (dipakai: php artisan db:seed --class=SetupSeeder)
BOOKING_ADMIN_EMAIL=            # GANTI
BOOKING_ADMIN_PASSWORD=         # GANTI, wajib di production

# Rekening platform untuk tagihan langganan
BOOKING_PLATFORM_BANK_NAME=
BOOKING_PLATFORM_BANK_NUMBER=
BOOKING_PLATFORM_BANK_HOLDER=

# Nginx di server yang sama: 127.0.0.1. Di belakang load balancer isi IP-nya, atau "*" bila yakin.
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=booking_villa
DB_USERNAME=booking_villa
DB_PASSWORD=                    # GANTI

# Sesi dibagi ke seluruh subdomain bila domain induk sama. Kosongkan jika tidak ingin berbagi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=                      # GANTI
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@domainkamu.com
MAIL_FROM_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12
